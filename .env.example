# Copy to .env for local development. Never commit .env.

# Neon: use the POOLED connection string (host contains "-pooler").
NUXT_DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# The one admin account.
NUXT_ADMIN_EMAIL=you@example.com
# Output of: npm run hash-password -- "your password"
NUXT_ADMIN_PASSWORD_HASH=

# Seals the login cookie. Generate with: openssl rand -base64 32
NUXT_APP_SECRET=

# Vercel Blob read/write token. Leave empty locally to store frames in .data/uploads instead.
BLOB_READ_WRITE_TOKEN=
